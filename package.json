{
  "name": "oneshot-v3-3-evidence-ux",
  "version": "3.3.0",
  "private": true,
  "scripts": {
    "web:prepare": "node APK/scripts/prepare-webdir.js",
    "android:prepare-permissions": "node APK/scripts/install-android-permissions.js",
    "android:prepare-branding": "node APK/scripts/install-android-branding.js",
    "android:prepare-native": "node APK/scripts/install-whatsapp-native.js && node APK/scripts/install-android-permissions.js && node APK/scripts/install-android-branding.js",
    "android:verify-native": "node APK/scripts/verify-native.js",
    "android:sync": "npm run web:prepare && npx cap sync android",
    "android:open": "npx cap open android",
    "android:debug:win": "cd android && ./gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1"
  }
}
